# ============================================================
# EDA SUMMARY
# ============================================================

print("\n================================================")
print("EDA COMPLETED")
print("================================================")

print("\nDataset shape:", df.shape)

print(
    "Total missing values:",
    df.isnull().sum().sum()
)

print(
    "Duplicate rows:",
    df.duplicated().sum()
)

print(
    "Laundering transactions:",
    (df["Is_laundering"] == 1).sum()
)

print(
    "Legitimate transactions:",
    (df["Is_laundering"] == 0).sum()
)

print("\n================================================")
print("EXPLORATORY DATA ANALYSIS FINISHED")
print("================================================")
